# GOWINMALL — Variables d'environnement
# Copier ce fichier vers .env.local et remplir les valeurs

# ============================================
# SUPABASE (obligatoire)
# ============================================
# URL du projet Supabase (ex: https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique (anon key) — côté client
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète (service_role) — côté serveur UNIQUEMENT
# Ne JAMAIS exposer côté client (pas de NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# URL DU SITE (obligatoire en production)
# ============================================
# URL publique de l'application (ex: https://gowinmall.vercel.app)
# En dev, Next.js utilise localhost:3000 par défaut
NEXT_PUBLIC_SITE_URL=

# ============================================
# GOOGLE OAUTH (optionnel - pour "Continuer avec Google")
# ============================================
# Créer un projet Google Cloud, activer OAuth 2.0
# Authorized redirect URIs: https://<PROJECT>.supabase.co/auth/v1/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# STORAGE BUCKETS (créer dans Supabase Dashboard > Storage)
# ============================================
# Bucket public pour les images de couverture d'offres
# Nom: offer-covers
# Public: YES
# Policies: INSERT/SELECT pour authenticated users

# Bucket privé pour les documents d'identité
# Nom: identity-documents
# Public: NO
# Policies: INSERT/SELECT pour authenticated users (owner only)

# ============================================
# CONFIGURATION SUPPLÉMENTAIRE
# ============================================
# Activer les logs de debug (dev seulement)
# NEXT_PUBLIC_DEBUG=true

# Région pour formatage dates/prix (fr-FR par défaut)
# NEXT_PUBLIC_LOCALE=fr-FR

# Fuseau horaire pour affichage (Africa/Kinshasa par défaut)
# NEXT_PUBLIC_TIMEZONE=Africa/Kinshasa